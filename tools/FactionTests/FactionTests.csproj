<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline tests for RCK's pure faction rules (grade precedence, the FactionRel matrix and recruit policies). No game DLLs needed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- FactionProfile.Member is only read by the game side. -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\RCK\Systems\Social\FactionRules.cs" Link="Rck\FactionRules.cs" />
    <Compile Include="..\..\RCK\Systems\Social\FactionMatrix.Rules.cs" Link="Rck\FactionMatrix.Rules.cs" />
    <Compile Include="..\..\RCK\Systems\Social\FactionRecruit.Rules.cs" Link="Rck\FactionRecruit.Rules.cs" />
  </ItemGroup>
</Project>

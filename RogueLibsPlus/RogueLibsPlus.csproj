<Project Sdk="Microsoft.NET.Sdk">

  <!-- RogueLibsPlus: our fixes and APIs on top of an unmodified RogueLibs (Dzhake's v4.0.0-rc.3).
       RogueLibsCore comes from .ref\roguelibs (tools\get-roguelibs.ps1 fetches and verifies it). -->
  <PropertyGroup>
    <TargetFramework>net471</TargetFramework>
    <AssemblyName>RogueLibsPlus</AssemblyName>
    <RootNamespace>RogueLibsPlus</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>1.0.0</Version>
    <Authors>RogueLibsPlus contributors</Authors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DebugType Condition="'$(Configuration)'=='Release'">none</DebugType>
    <RefDir Condition="'$(RefDir)'==''">$(MSBuildThisFileDirectory)..\.ref\</RefDir>
    <ImplicitlyExpandNETStandardFacades>false</ImplicitlyExpandNETStandardFacades>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="0Harmony"><HintPath>$(RefDir)static\0Harmony.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(RefDir)static\BepInEx.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(RefDir)Assembly-CSharp.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Assembly-CSharp-firstpass"><HintPath>$(RefDir)static\Assembly-CSharp-firstpass.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Mirror"><HintPath>$(RefDir)static\Mirror.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="netstandard"><HintPath>$(RefDir)static\netstandard.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(RefDir)static\UnityEngine.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(RefDir)static\UnityEngine.CoreModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(RefDir)static\UnityEngine.AudioModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(RefDir)static\UnityEngine.UI.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(RefDir)static\UnityEngine.UIModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(RefDir)static\UnityEngine.TextRenderingModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(RefDir)static\UnityEngine.IMGUIModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(RefDir)static\Unity.TextMeshPro.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="RogueLibsCore"><HintPath>$(RefDir)roguelibs\RogueLibsCore.dll</HintPath><Private>False</Private></Reference>
  </ItemGroup>

</Project>
